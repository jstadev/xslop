{
  "name": "xslop-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "xslop web pages and admin console.",
  "license": "MIT",
  "author": "xslop contributors",
  "homepage": "https://x-slop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstadev/xslop.git",
    "directory": "site"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --test test/unit/*.test.ts && npm run build && node scripts/check-build.ts",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
