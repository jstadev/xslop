# Every environment variable that the code reads. Values stay empty here; put real values in your own .env or env file.

# Server (server/src/env.ts)
# Postgres URL, for example postgres://xslop_app:<password>@127.0.0.1:5432/xslop. The role's search_path selects the schema.
DATABASE_URL=
# Listen port on 127.0.0.1. Default 3995.
PORT=
# 64 hex characters each, for example the output of: openssl rand -hex 32
XSLOP_SECRET=
XSLOP_IP_SALT=
# Optional, both or neither. The hash comes from: node server/dist/scripts/hash-password.js (reads the password on stdin).
XSLOP_ADMIN_USER=
XSLOP_ADMIN_HASH=
# Optional, needs the two above. A base32 TOTP secret (16 to 128 characters of A-Z and 2-7, for example 32): a login then
# also needs the 6-digit code of an authenticator app (RFC 6238, SHA-1, 30 seconds). Each code works once.
XSLOP_ADMIN_TOTP=
# Optional. Proof of work bits, 8 to 22. Default 18.
XSLOP_POW_BITS=
# Optional. The public origin of the site, for example http://127.0.0.1:3995. Default https://x-slop.com.
XSLOP_SITE_ORIGIN=
# Optional. The folder that holds site/dist and extension/dist. Default: the repository root.
XSLOP_STATIC_ROOT=

# Tests only (server): a throwaway Postgres database. Set, the server tests also run against it.
TEST_DATABASE_URL=

# Build only (extension): the API origin baked into the build (https, or http on 127.0.0.1 or localhost).
XSLOP_API=
# Tests only (extension e2e): a running xslop server to test against. Empty: the tests use their mock server.
XSLOP_E2E_API=
